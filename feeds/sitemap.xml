---
layout: empty
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign home_page = site.html_pages | where: "url", "/" | first %}
  <url>
    <loc>{{ site.url }}</loc>
    <lastmod>{% if home_page.last_modified_at %}{{ home_page.last_modified_at }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</lastmod>
  </url>
  <!-- pages-->
  {% for page in site.html_pages %}
  {% if page.url != "/" and page.sitemap != false and page.robots != "noindex" %}
  <url>
    <loc>{{ site.url }}{{ page.url }}</loc>
    <lastmod>{% if page.last_modified_at %}{{ page.last_modified_at }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</lastmod>
  </url>
  {% endif %}
  {% endfor %}
  <!-- projects -->
  {% assign links = site.projects %}
  {% for link in links %}
    <url>
      <loc>{{ link.url | replace:'/index.html','/' | absolute_url | xml_escape }}</loc>
      {% if link.last_modified_at or link.date %}
        <lastmod>{{ link.last_modified_at | default: link.date | date_to_xmlschema }}</lastmod>
      {% endif %}
    </url>
  {% endfor %}
  <!-- posts-->
{% assign posts = site.posts | where_exp: "post", "post.robots != 'noindex'" %}
  {% for post in posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}
</urlset>
